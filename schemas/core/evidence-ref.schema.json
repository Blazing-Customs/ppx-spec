{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppx.dev/schemas/core/evidence-ref.schema.json",
  "title": "PPX Evidence Reference",
  "description": "A pointer to supporting data for a claim. Payload MAY remain private; only the reference and a summary need be portable.",
  "type": "object",
  "required": ["evidence_id", "kind", "timestamp", "visibility"],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^ppx:evidence:[A-Za-z0-9_.:-]+$"
    },
    "kind": {
      "type": "string",
      "description": "The evidence modality (e.g. `pairwise_choice`, `behavior_log`, `self_report`, `imported_profile`).",
      "minLength": 1
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "visibility": {
      "type": "string",
      "enum": ["public", "grantee_only", "provider_only"]
    },
    "summary": {
      "type": "string",
      "description": "Human-readable, privacy-safe summary of the evidence."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "description": "OPTIONAL opaque URI for retrieving evidence payload when visibility permits."
    }
  },
  "additionalProperties": false
}
