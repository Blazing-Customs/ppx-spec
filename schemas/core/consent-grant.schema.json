{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppx.dev/schemas/core/consent-grant.schema.json",
  "title": "PPX Consent Grant",
  "description": "A first-class, user-controlled authorization that defines who may access which claims, for what purpose, under what constraints, and for how long.",
  "type": "object",
  "required": ["grant_id", "subject_id", "grantee_id", "status", "granted_at", "purposes", "allowed_domains", "allowed_namespaces", "allowed_operations", "cross_domain_transfer", "writeback_policy"],
  "properties": {
    "grant_id": {
      "type": "string",
      "pattern": "^ppx:grant:[A-Za-z0-9_.:-]+$"
    },
    "subject_id": { "type": "string", "minLength": 1 },
    "grantee_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["active", "expired", "revoked", "pending"]
    },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "recommendation",
          "ranking",
          "matching",
          "simulation",
          "summarization",
          "personalization",
          "explanation",
          "propose_update"
        ]
      },
      "minItems": 1
    },
    "allowed_domains": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "allowed_namespaces": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "allowed_claim_keys": {
      "type": "array",
      "items": { "type": "string" },
      "description": "If present, restricts access to only these keys. If omitted, access is bounded by namespace and domain only."
    },
    "allowed_operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read", "query", "propose_update", "confirm_update", "export"]
      },
      "minItems": 1
    },
    "cross_domain_transfer": {
      "type": "string",
      "enum": ["deny", "allow_with_review", "allow_if_same_provider", "allow"]
    },
    "writeback_policy": {
      "type": "string",
      "enum": ["forbidden", "review_required", "auto_for_low_risk", "allow"]
    },
    "redisclosure": {
      "type": "string",
      "enum": ["forbidden", "same_purpose_only", "allow"]
    },
    "audit": {
      "type": "object",
      "properties": {
        "log_access": { "type": "boolean" },
        "notify_on_writeback": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
