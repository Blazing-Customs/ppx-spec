{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppx.dev/schemas/core/extension-descriptor.schema.json",
  "title": "PPX Extension Descriptor",
  "description": "A domain-specific vocabulary registered under a unique namespace.",
  "type": "object",
  "required": ["namespace", "version", "title", "keys"],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Lowercase, snake_case namespace identifier."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[A-Za-z0-9.-]+)?$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "value_type"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value_type": {
            "type": "string",
            "enum": ["float", "int", "bool", "string", "string_list", "map", "map<string,float>"]
          },
          "units": { "type": "string" },
          "description": { "type": "string" },
          "allowed_values": {
            "description": "If `value_type` is `string`, constrains value to this enumeration.",
            "type": "array",
            "items": { "type": "string" }
          },
          "provenance_guidance": { "type": "string" },
          "confidence_guidance": { "type": "string" }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "privacy_guidance": {
      "type": "object",
      "properties": {
        "cross_domain_use": {
          "type": "string",
          "enum": ["recommended", "discouraged_without_review", "forbidden"]
        },
        "high_impact": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
